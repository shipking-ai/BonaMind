# IDE / agent tooling
# These hold per-developer settings, so they stay untracked. Note that .claude/
# was already listed here while .claude/settings.local.json was still in the
# index: a gitignore rule does not untrack anything. If one of these ever gets
# committed, `git rm --cached` it rather than deleting the rule.
.claude/
.cline/
.cursor/
.opencode/
opencode.json
.freebuff/
.kimchi/

# Local verify-build output
bonamind-web/dist-verify/
.vercel
.env*
# Build-mode overrides that hold only public API origins, never secrets.
!bonamind-web/.env.mobile
!bonamind-web/.env.desktop

# Root-level design reference media (screenshots/video of the landing page)
/landing-*.png
/landing-video.mp4
/video-frame-*.png
