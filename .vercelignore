# Old/removed API routes
api/delete-account.ts
api/digest.ts
api/reminder.ts
api/welcome.ts

# API tests (never deployed as functions; run in CI)
api/tests/

# Dev-only API tooling (local dev server, scripts, and express router).
# The only deployed functions are api/index.ts (catch-all) and
# api/stripe-webhook.ts (raw-body webhook). Imported helpers live under
# underscore-prefixed paths (_chatHandler.ts, _middleware.ts, _lib/) which
# Vercel ignores as function entry points but still bundles.
# NOTE: api/package.json, package-lock.json, and tsconfig.json are NOT ignored
# — Vercel needs them to install function dependencies and compile TS.
api/scripts/
api/server.js
api/routes/
api/vitest.config.mts
api/.env
api/node_modules/

# AI model files (local inference only, not for Vercel)
content/
model-service/

# Local env files (Vite bakes every VITE_ var into the client bundle —
# uploading these leaked real credentials into the public JS)
.env
.env.local
.env.production
.env.development
bonamind-web/.env
bonamind-web/.env.local
bonamind-web/.env.production
bonamind-web/.env.development

# Native app builds and source
bonamind-web/src-tauri/
bonamind-web/android/
bonamind-web/ios/

# Frontend dependencies and build output (installed/built remotely;
# excluding them cuts CLI deploys from ~1.3GB to a few MB)
node_modules/
bonamind-web/node_modules/
bonamind-web/dist/

# Database migrations (applied via Supabase CLI)
supabase/

# Generated training data and large assets
*.safetensors
*.jsonl

# IDE and tooling
.claude/
.cline/
.cursor/

# Root docs (not needed at runtime)
ARCHITECTURE.md
CHANGELOG.md
DEPLOYMENT.md
fix-corruption.ps1
