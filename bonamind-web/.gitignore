# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# Environment files (secrets — never commit)
.env
.env.*.local
.env.mobile

# Tauri signing key
privatekey.pem*

# ── ANDROID: keystore + signing material ────────────────────────
android/keystore/*.keystore
android/keystore/*.jks
android/keystore/release.keystore
android/keystore/upload.keystore
android/app/google-services.json
android/app/.cxx/
android/build/
android/app/build/
android/local.properties

# ── iOS: per-machine + per-build artifacts ──────────────────────
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/App.xcworkspace/xcuserdata/
ios/App/Pods/
ios/App/build/
ios/build/
ios/DerivedData/
ios/.build/
*.mobileprovision
ios/App/App.xcodeproj/project.pbxproj.userdata
# Local certs (anchor under fastlane/secrets to avoid catching .cer code files)
fastlane/**/*.cert
fastlane/**/*.p12
*.mobileprovision
*.p12

# ── fastlane: per-run reports + screenshots cache ───────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/.fastlane_history

# ── Capacitor build artifacts + synced web bundle ───────────────
android/app/src/main/assets/public/
ios/App/App/public/
ios/App/App/capacitor.config.json
!ios/App/App/capacitor.config.json.override

# ── Local-only / scope-private configs (NEVER commit) ───────────
*.google-services.json
firebase-service-account.json
keystore.properties

# ── Misc build outputs ─────────────────────────────────────────
.turbo
coverage/
.nyc_output/
junit-*.xml
tsc.out
build.log

# ── Local workspace artifacts ──────────────────────────────────
.freebuff/
.kimchi/
test-results/

# Playwright storage states contain live session tokens - never commit.
e2e/.auth/
preview-*.html
