{
  "name": "bonamind",
  "private": true,
  "version": "2.3.6",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "BonaMind — adaptive AI learning system (React app, PWA, Capacitor Android/iOS, and the Tauri Windows app).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host --port 3001",
    "build": "vite build",
    "size": "npm run build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx vercel --prod --archive=tgz",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "analyze": "npx vite-bundle-visualizer",
    "migrate": "node ../run-migrations.js",
    "migrate:dry": "node ../run-migrations.js --dry-run",
    "migrate:status": "node scripts/migrate-status.cjs",
    "diagnostics": "node scripts/check-migration-drift.cjs && node scripts/check-remote-drift.cjs",
    "diagnostics:drift": "node scripts/check-migration-drift.cjs",
    "diagnostics:remote": "node scripts/check-remote-drift.cjs",
    "build:android": "vite build --mode mobile && npx cap sync android",
    "build:apk:debug": "vite build --mode mobile && npx cap sync android && node scripts/build-debug-apk.mjs",
    "build:aab:release": "vite build --mode mobile && npx cap sync android && node scripts/run-gradle.mjs bundleRelease",
    "cap:sync": "npx cap sync android",
    "brand:check": "node scripts/brand-sync.mjs",
    "brand:sync": "node scripts/brand-sync.mjs --write",
    "og:build": "node scripts/build-og-image.mjs",
    "build:ios": "vite build --mode mobile && npx cap sync ios",
    "build:ios-preview": "node scripts/build-ios-preview.mjs",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop:web": "vite build --mode desktop",
    "build:desktop": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bonamind/core": "file:../packages/core",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@heyputer/puter.js": "^2.6.2",
    "@mlc-ai/web-llm": "^0.2.85",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.103.2",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "animejs": "^4.5.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "pdfjs-dist": "^6.2.108",
    "posthog-js": "^1.366.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-katex": "^3.1.0",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.8",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
