<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ system splash icon (windowSplashScreenAnimatedIcon).

  The OS animates this itself on launch, so no AnimatedVectorDrawable is
  needed — and none is risked: a malformed AVD throws at inflation and would
  crash every cold start. Art is the Aura mark reduced to what reads at a
  glance: the orbit ring, the core, one cyan satellite.

  Keep all art inside the central 72dp circle: the system masks the icon and
  clips everything outside it. Ring edge sits at 29dp from center, satellite
  at 31dp — both inside the mask with room to spare.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M27,54 a27,27 0 1,0 54,0 a27,27 0 1,0 -54,0"
        android:strokeColor="#8B5CF6"
        android:strokeWidth="4"
        android:fillColor="#00000000" />

    <path
        android:pathData="M50,27 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#67E8F9" />

    <path
        android:pathData="M45,54 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
        android:fillColor="#EDE9FE" />
</vector>
