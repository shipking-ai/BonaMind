<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose. The system clamps widget updates to a
  30-minute minimum anyway, and a due count that refreshes on its own
  schedule would drift out of step with the app. The app broadcasts
  WIDGET_REFRESH when the count actually changes instead, which is both more
  accurate and cheaper on battery.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="240dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_bonamind"
    android:previewLayout="@layout/widget_bonamind"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
