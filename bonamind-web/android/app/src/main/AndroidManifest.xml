<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true">

        <!-- allowBackup is false, deliberately. BiometricAuthPlugin parks the
             Supabase session in EncryptedSharedPreferences, whose AES keys live
             in the Android Keystore — device-bound and never included in a
             backup. A restored copy therefore carries ciphertext that cannot be
             decrypted on the new device: getCredentials rejects with
             "vault_error" and the user signs in normally, so this is not a
             lockout, but it IS dead weight in every backup.

             Nothing irreplaceable is lost by disabling it. Decks, cards and
             sessions are server-side in Supabase; every localStorage key is
             re-derivable preference state (theme, consent, reminder times,
             last-review-prompt timestamp). This also keeps the Play
             data-safety declaration honest: with backup on, the form has to
             declare encrypted data in cloud backup that then cannot be read. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share target. This is the capability the website cannot have:
                 a browser tab is somewhere you go, whereas a share target is
                 somewhere the OS can send things. Every other app on the
                 phone becomes an input funnel for deck creation.

                 text/plain covers a highlighted passage or a URL from a
                 browser; the document and image types cover a PDF, a slide
                 deck, or a photo of a textbook page. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Deep links for launcher shortcuts (and anything else that can
                 open a URL): bonamind://app/<path>, and the pre-rename
                 auramind://app/<path> that older shortcuts, widgets and (legacy-name: ok)
                 notifications still send. Capacitor's App plugin
                 forwards these to the JS `appUrlOpen` listener, which routes
                 them — see NativeRuntime. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bonamind" android:host="app" />
                <data android:scheme="auramind" android:host="app" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Receives grade data from the paired Wear OS app (BonaMind watch
             companion). Runs while the app is in the background. -->
        <service
            android:name=".WearSyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/auramind" />
            </intent-filter>
        </service>
    
        <!-- Home-screen widget. ACTION_REFRESH is sent by the app whenever the
             due count changes; APPWIDGET_UPDATE covers add-to-home-screen and
             the system's own update passes. -->
        <receiver
            android:name=".AuraMindWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.auramind.app.WIDGET_REFRESH" />
                <!-- Redraw from persisted prefs after a reboot. -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bonamind_widget_info" />
        </receiver>

        <!-- Quick Settings tile: due count + one tap into review. Reads the
             same prefs as the widget. Exported because SystemUI binds it;
             the BIND_QUICK_SETTINGS_TILE permission restricts who can. -->
        <service
            android:name=".QuickReviewTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_review"
            android:label="@string/tile_review_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- Spoken study reminder: speaks a random or chosen message when the
             reminder fires, app open or not. Re-arms itself after a reboot,
             an update, or a clock/time-zone change, since alarms don't
             survive those. Not exported: only the system and the app send
             these broadcasts. -->
        <receiver
            android:name=".SpokenReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.auramind.app.SPOKEN_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
</application>

    <!-- Android 11+ package visibility: without these, TextToSpeech and
         SpeechRecognizer cannot find the installed speech services. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice study answers (BonaListenPlugin / SpeechRecognizer) + audio transcription -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Haptic feedback on study answers (Capacitor Haptics uses the Vibrator) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Biometric app-lock (BiometricAuthPlugin; normal permission, granted at install) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Review reminders on Android 13+ (local notifications) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 16 Live Updates: promotes the ongoing study-session
         notification to the status bar chip and the lock screen. Normal
         permission; the user can still turn Live Updates off per app. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Widget redraw and spoken-reminder re-arm after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
