# BonaMind Environment Variables
# Copy this to .env (or .env.local) and fill in your values.
#
# Client-side keys are prefixed VITE_ and ship in the public bundle.
# Server-side keys (no VITE_ prefix) are read by the /api functions only.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Same URL as VITE_SUPABASE_URL, unprefixed. The serverless functions read
# this one — the Stripe webhook and the dunning cron use it, not the VITE_ var.
SUPABASE_URL=https://your-project.supabase.co

# AI
# Client calls /api/ai/* (Vercel function) with their Supabase session; the
# function injects the server-side key. VITE_GROQ_API_KEY is deliberately NOT
# used anymore — the client bundle must never contain a Groq key.
# Providers are tried in this order and a provider with no key is skipped,
# so one key is enough. On 429 / 401 / 403 / 5xx the proxy fails over to the
# next one — a spent free quota becomes a different free tier, not an outage.
# All four are free-tier friendly; all speak the OpenAI chat-completions shape.
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional per-provider model overrides. Set one of these if a provider
# renames or retires the default model (the symptom is a 400/404 naming it).
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=llama-3.3-70b
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Puter is the last resort and costs the developer nothing: it bills the
# user's own Puter account. Enabled by default; the SDK loads from
# https://js.puter.com (which must stay in the CSP script-src).
# VITE_USE_PUTER=true
# VITE_PUTER_MODEL=gpt-5-nano
VITE_USE_LOCAL_AI=false
VITE_AI_MODEL=openai/gpt-oss-120b

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
VITE_STRIPE_PRICE_ID_MONTHLY=price_your-monthly-id
VITE_STRIPE_PRICE_ID_ANNUAL=price_your-annual-id
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email (Resend — server-side)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@your-domain.com

# Search (Google Custom Search — server-side). BOTH are required; with only
# the key, /api/search returns an error.
GOOGLE_SEARCH_API_KEY=your-google-cse-key
GOOGLE_SEARCH_ENGINE_ID=your-cse-engine-id

# Analytics
VITE_POSTHOG_KEY=your-posthog-key

# Model service (optional Python streaming-chat backend)
MODEL_SERVICE_URL=http://127.0.0.1:8000

# Owner Email (gets admin privileges automatically)
VITE_OWNER_EMAIL=your-email@example.com

# App URL
VITE_APP_URL=http://localhost:3000

# Rate limiting (server-side, production)
# Without these the API limiter falls back to per-instance memory, which on
# Vercel means the effective limit multiplies by the number of warm instances.
# Set both in production so limits hold across all instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dunning cron (server-side)
# vercel.json schedules /api/cron/dunning daily at 14:00 UTC. The endpoint
# fails CLOSED: with CRON_SECRET unset it returns 401 on every run, so
# failed-payment recovery emails never go out and the failure is silent.
# Set this in Vercel and it is sent automatically as the cron's bearer token.
CRON_SECRET=
# Days a past_due subscription keeps access before being cut off.
# DUNNING_GRACE_DAYS=7

# Admin (server-side). Grants admin to this address in the API layer.
# Separate from VITE_OWNER_EMAIL, which is the client-side owner marker —
# set both to the same address unless you intend them to differ.
ADMIN_EMAIL=your-email@example.com

# CORS for the standalone Express dev server only (ignored on Vercel, where
# vercel.json owns the headers). Defaults to '*' when unset.
# ALLOWED_ORIGIN=http://localhost:3000

# Cloudflare Turnstile (CAPTCHA on signup / login / password reset)
# The SITE key is public and belongs in the client bundle. The SECRET is
# pasted into Supabase (Authentication -> Attack Protection) and must never
# appear here or in any VITE_ variable.
# Leave unset in dev: the widget renders nothing and auth keeps working.
VITE_TURNSTILE_SITE_KEY=
